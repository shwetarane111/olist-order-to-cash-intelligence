
-- =====================================================
-- PROJECT: Order-to-Cash Intelligence Platform
-- FILE: 09_kpi_gap_closure_part1.dax
-- STEP 7.3 - TASK 10
-- PURPOSE: Close nine business KPI coverage gaps
-- SOURCE: analytics.fact_orders and analytics.fact_order_reviews
-- =====================================================

-- FILE USAGE
-- Each formula is created INDIVIDUALLY using New measure
-- under _Measures in Power BI Desktop.
-- This .dax file is a version-controlled reference, not
-- a single executable DAX query.

-- =====================================================
-- SECTION 1: ALL TEN MEASURE DEFINITIONS
-- =====================================================

-- MEASURE 1 | KPI-003: Orders With Items
-- Order fact records with at least one item record.
-- Full-data baseline: 98,666.

Orders With Items (Order Fact) =
COALESCE(
    CALCULATE(
        [Total Orders],
        KEEPFILTERS(
            'fact_orders'[has_item_records] = TRUE()
        )
    ),
    0
)


-- MEASURE 2 | KPI-011: Delivered Order AOV: Item + Freight
-- Delivered and item-backed orders only.
-- Full-data value checked in PostgreSQL; exact value
-- was not supplied in this conversation.
-- Q1 2018 delivered cohort: R$153.42.

Delivered Order AOV - Item and Freight =
VAR EligibleValue =
    CALCULATE(
        SUM('fact_orders'[item_plus_freight_total]),
        KEEPFILTERS(
            'dim_order_status'[order_status] = "delivered"
        ),
        KEEPFILTERS(
            'fact_orders'[has_item_records] = TRUE()
        )
    )
VAR EligibleOrders =
    CALCULATE(
        [Total Orders],
        KEEPFILTERS(
            'dim_order_status'[order_status] = "delivered"
        ),
        KEEPFILTERS(
            'fact_orders'[has_item_records] = TRUE()
        )
    )
RETURN
    DIVIDE(EligibleValue, EligibleOrders)


-- MEASURE 3 | KPI-015: Payment Reconciliation Mismatch Rate
-- Mismatched orders divided by comparable orders.
-- Full-data baseline: 0.58%.

Financial Mismatch Rate =
DIVIDE(
    COALESCE([Mismatched Orders], 0),
    [Comparable Orders]
)


-- MEASURE 4 | KPI-020: Delivered Order Share
-- Full-data baseline: 97.02%.

Delivered Order Share =
DIVIDE(
    COALESCE([Delivered Orders], 0),
    [Total Orders]
)


-- MEASURE 5 | Supporting measure for KPI-021: Canceled Orders
-- Full-data baseline: 625.

Canceled Orders =
COALESCE(
    CALCULATE(
        [Total Orders],
        KEEPFILTERS(
            'dim_order_status'[order_status] = "canceled"
        )
    ),
    0
)


-- MEASURE 6 | KPI-021: Canceled Order Share
-- Full-data baseline: 0.63%.

Canceled Order Share =
DIVIDE(
    [Canceled Orders],
    [Total Orders]
)


-- MEASURE 7 | KPI-022: Delivery Evaluation Coverage
-- Evaluable delivered orders divided by all delivered orders.
-- Full-data baseline: 99.99%; 8 delivered records
-- have missing actual customer-delivery dates.

Delivery Evaluation Coverage =
DIVIDE(
    COALESCE([Evaluable Delivered Orders], 0),
    [Delivered Orders]
)


-- MEASURE 8 | KPI-024: Late Delivery Rate
-- Late deliveries divided by evaluable delivered orders.
-- Full-data baseline: 6.77%.

Late Delivery Rate =
DIVIDE(
    COALESCE([Late Deliveries], 0),
    [Evaluable Delivered Orders]
)


-- MEASURE 9 | KPI-027: Delivered Orders Missing Actual Delivery Date
-- Full-data baseline: 8.

Delivered Orders Missing Actual Delivery Date =
COALESCE(
    CALCULATE(
        [Total Orders],
        KEEPFILTERS(
            'dim_order_status'[order_status] = "delivered"
        ),
        KEEPFILTERS(
            ISBLANK(
                'fact_orders'[order_delivered_customer_date]
            )
        )
    ),
    0
)


-- MEASURE 10 | KPI-053: Written Feedback Availability Rate
-- Review-record numerator: at least a title or message.
-- Full-data baseline: 43.03%.

Written Feedback Availability Rate =
DIVIDE(
    [Reviews With Written Feedback],
    [Review Records]
)


-- =====================================================
-- SECTION 2: MEASURE FORMATTING
-- =====================================================
-- Orders With Items (Order Fact): Whole number, 0 decimals
-- Delivered Order AOV - Item and Freight: BRL Currency, 2 decimals
-- Financial Mismatch Rate: Percentage, 2 decimals
-- Delivered Order Share: Percentage, 2 decimals
-- Canceled Orders: Whole number, 0 decimals
-- Canceled Order Share: Percentage, 2 decimals
-- Delivery Evaluation Coverage: Percentage, 2 decimals
-- Late Delivery Rate: Percentage, 2 decimals
-- Delivered Orders Missing Actual Delivery Date: Whole number, 0 decimals
-- Written Feedback Availability Rate: Percentage, 2 decimals


