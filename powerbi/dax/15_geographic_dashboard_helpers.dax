
-- ======================================================
-- PROJECT: Order-to-Cash Intelligence Platform
-- STEP: 7.4 Task 6
-- PAGE: 06 Geographic Coverage & Data Quality
-- FILE: 15_geographic_dashboard_helpers.dax
-- ======================================================

-- This file is a version-controlled DAX reference.
-- Do not execute all definitions as one query.
--
-- MEASURES: Create separately under _Measures.
-- COLUMNS: Create separately in dim_customer_geography.
-- TABLE: Create using Modeling > New table.
--
-- The geographic dashboard uses a customer-state
-- ranking bar chart. It does NOT require Azure Maps,
-- Power BI Service or a university account.


-- ======================================================
-- SECTION 1: GEOGRAPHIC HELPER MEASURES
-- ======================================================

-- MEASURE 1
-- Format: Whole number, 0 decimals.
-- ALL: 99,163.
-- Q1 delivered: 20,568.

Geo Referenced Orders (Dashboard) =
COALESCE(
    CALCULATE(
        [Total Orders],
        KEEPFILTERS(
            'dim_customer_geography'[has_geo_reference]
                = TRUE()
        )
    ),
    0
)


-- MEASURE 2
-- Format: Percentage, 2 decimals.

Map-Ready Item Share (Dashboard) =
DIVIDE(
    [Map-Ready Item Entries],
    [Order Item Entries]
)


-- MEASURE 3
-- Format: Percentage, 2 decimals.

Map-Ready Payment Share (Dashboard) =
DIVIDE(
    [Map-Ready Payment Entries],
    [Payment Entries]
)


-- MEASURE 4
-- Format: Percentage, 2 decimals.

Map-Ready Review Share (Dashboard) =
DIVIDE(
    [Map-Ready Review Records],
    [Review Records]
)


-- ======================================================
-- SECTION 2: CALCULATED COLUMNS
-- TABLE: dim_customer_geography
-- ======================================================

-- COLUMN 1

Geographic Quality Category =
SWITCH(
    TRUE(),
    'dim_customer_geography'[has_geo_reference]
        <> TRUE(),
        "Missing ZIP Reference",

    'dim_customer_geography'[is_reference_coordinate_outlier]
        = TRUE(),
        "Flagged Coordinate",

    'dim_customer_geography'[has_map_ready_coordinate]
        = TRUE(),
        "Map-Ready",

    "Other / Inspect"
)


-- COLUMN 2

Geographic Quality Sort =
SWITCH(
    TRUE(),
    'dim_customer_geography'[has_geo_reference]
        <> TRUE(), 1,

    'dim_customer_geography'[is_reference_coordinate_outlier]
        = TRUE(), 2,

    'dim_customer_geography'[has_map_ready_coordinate]
        = TRUE(), 3,

    4
)


-- Sort Geographic Quality Category by
-- Geographic Quality Sort in Column tools.


-- ======================================================
-- SECTION 3: DISCONNECTED PRESENTATION TABLE
-- ======================================================

Geo Fact Type =
DATATABLE(
    "Fact", STRING,
    "Sort", INTEGER,
    {
        {"Orders", 1},
        {"Order Items", 2},
        {"Payments", 3},
        {"Reviews", 4}
    }
)


-- Expected: 4 rows, 2 columns.
-- No relationships.
-- Sort Fact by Sort.


-- ======================================================
-- SECTION 4: FACT COMPARISON MEASURES
-- ======================================================

-- MEASURE 5
-- Format: Percentage, 2 decimals.

Map-Ready Share by Fact (Dashboard) =
SWITCH(
    SELECTEDVALUE('Geo Fact Type'[Fact]),
    "Orders", [Map-Ready Order Share],
    "Order Items", [Map-Ready Item Share (Dashboard)],
    "Payments", [Map-Ready Payment Share (Dashboard)],
    "Reviews", [Map-Ready Review Share (Dashboard)],
    BLANK()
)


-- MEASURE 6
-- Format: Whole number, 0 decimals.

Map-Ready Records by Fact (Dashboard) =
SWITCH(
    SELECTEDVALUE('Geo Fact Type'[Fact]),
    "Orders", [Map-Ready Orders],
    "Order Items", [Map-Ready Item Entries],
    "Payments", [Map-Ready Payment Entries],
    "Reviews", [Map-Ready Review Records],
    BLANK()
)


-- MEASURE 7
-- Format: Whole number, 0 decimals.

Total Records by Fact (Dashboard) =
SWITCH(
    SELECTEDVALUE('Geo Fact Type'[Fact]),
    "Orders", [Total Orders],
    "Order Items", [Order Item Entries],
    "Payments", [Payment Entries],
    "Reviews", [Review Records],
    BLANK()
)


