
-- =====================================================
-- PROJECT: Order-to-Cash Intelligence Platform
-- STEP 7.3 - TASK 7
-- FILE: 07_product_seller_catalog_measures.dax
-- PURPOSE: Product, Seller, Item and Catalog KPIs
-- SOURCE: PostgreSQL analytics schema
-- =====================================================

-- IMPORTANT
-- Each definition below is created as a separate
-- measure under _Measures in Power BI Desktop.
-- This .dax file is a version-controlled reference.
-- It is not a standalone executable DAX query.


-- =====================================================
-- SECTION 1: PRODUCT AND SELLER ACTIVITY
-- =====================================================

-- MEASURE 1: Order Item Entries
-- Full-dataset baseline: 112,650
-- Grain: One order-item entry

Order Item Entries =
COALESCE(
    COUNTROWS('fact_order_items'),
    0
)


-- MEASURE 2: Orders With Item Records
-- Full-dataset baseline: 98,666
-- Counts distinct orders represented in the Item fact.

Orders With Item Records =
COALESCE(
    DISTINCTCOUNT('fact_order_items'[order_id]),
    0
)


-- MEASURE 3: Products With Item Records
-- Reported full-dataset baseline: 32,951
-- Counts distinct products represented in the Item fact.

Products With Item Records =
COALESCE(
    DISTINCTCOUNT('fact_order_items'[product_id]),
    0
)


-- MEASURE 4: Sellers With Item Records
-- Reported full-dataset baseline: 3,095
-- Counts distinct sellers represented in the Item fact.

Sellers With Item Records =
COALESCE(
    DISTINCTCOUNT('fact_order_items'[seller_id]),
    0
)


-- =====================================================
-- SECTION 2: ITEM AND FREIGHT VALUE
-- =====================================================

-- MEASURE 5: Recorded Item Price
-- Full-dataset baseline: R$13,591,643.70
-- Sum of recorded item prices, excluding freight.

Recorded Item Price =
SUM('fact_order_items'[item_price])


-- MEASURE 6: Recorded Freight Amount
-- Full-dataset baseline: R$2,251,909.54

Recorded Freight Amount =
SUM('fact_order_items'[freight_amount])


-- MEASURE 7: Average Item Price per Entry
-- Full-dataset baseline: R$120.65
-- Denominator: Order Item Entries

Average Item Price per Entry =
DIVIDE(
    [Recorded Item Price],
    [Order Item Entries]
)


-- MEASURE 8: Average Freight per Item Entry
-- Full-dataset baseline: R$19.99
-- Denominator: Order Item Entries

Average Freight per Item Entry =
DIVIDE(
    [Recorded Freight Amount],
    [Order Item Entries]
)


-- MEASURE 9: Freight Share of Item and Freight Value
-- Full-dataset baseline: 14.21%
-- Denominator: Recorded item prices plus freight

Freight Share of Item and Freight Value =
DIVIDE(
    [Recorded Freight Amount],
    [Recorded Item and Freight Value]
)


-- =====================================================
-- SECTION 3: MULTIPLE-ITEM ORDER ACTIVITY
-- =====================================================

-- MEASURE 10: Orders With Multiple Item Entries
-- Reported full-dataset baseline: 9,803
-- Counts orders with more than one visible item entry.

Orders With Multiple Item Entries =
COALESCE(
    COUNTROWS(
        FILTER(
            VALUES('fact_order_items'[order_id]),
            CALCULATE([Order Item Entries]) > 1
        )
    ),
    0
)


-- MEASURE 11: Maximum Item Entries Per Order
-- Reported full-dataset baseline: 21

Maximum Item Entries Per Order =
COALESCE(
    MAXX(
        VALUES('fact_order_items'[order_id]),
        CALCULATE([Order Item Entries])
    ),
    0
)


-- =====================================================
-- SECTION 4: PRODUCT CATALOG QUALITY
-- =====================================================

-- MEASURE 12: Translated Catalog Products
-- Full-dataset baseline: 32,328

Translated Catalog Products =
COALESCE(
    CALCULATE(
        COUNTROWS('dim_product'),
        KEEPFILTERS(
            'dim_product'[category_status] = "TRANSLATED"
        )
    ),
    0
)


-- MEASURE 13: Untranslated Catalog Products
-- Full-dataset baseline: 13

Untranslated Catalog Products =
COALESCE(
    CALCULATE(
        COUNTROWS('dim_product'),
        KEEPFILTERS(
            'dim_product'[category_status] = "UNTRANSLATED"
        )
    ),
    0
)


-- MEASURE 14: Missing-Category Catalog Products
-- Full-dataset baseline: 610

Missing-Category Catalog Products =
COALESCE(
    CALCULATE(
        COUNTROWS('dim_product'),
        KEEPFILTERS(
            'dim_product'[category_status]
                = "MISSING_SOURCE_CATEGORY"
        )
    ),
    0
)


-- MEASURE 15: Catalog Products Missing Physical Attributes
-- Full-dataset baseline: 2

Catalog Products Missing Physical Attributes =
COALESCE(
    CALCULATE(
        COUNTROWS('dim_product'),
        KEEPFILTERS(
            'dim_product'[has_missing_physical_attributes]
                = TRUE()
        )
    ),
    0
)


-- MEASURE 16: Zero-Weight Catalog Products
-- Full-dataset baseline: 4

Zero-Weight Catalog Products =
COALESCE(
    CALCULATE(
        COUNTROWS('dim_product'),
        KEEPFILTERS(
            'dim_product'[is_zero_weight] = TRUE()
        )
    ),
    0
)


-- =====================================================
-- SECTION 5: FULL-DATASET VALIDATION BASELINES
-- =====================================================

-- ITEM AND SELLER ACTIVITY
-- Order Item Entries: 112,650
-- Orders With Item Records: 98,666
