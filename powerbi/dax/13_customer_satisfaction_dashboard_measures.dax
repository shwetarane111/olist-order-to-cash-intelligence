-- =====================================================
-- MEASURE 1: Repeat Customer Share (Dashboard)
-- =====================================================

Repeat Customer Share (Dashboard) =
DIVIDE(
    [Repeat-Order Customer Identities],
    [Customer Identities With Orders]
)


