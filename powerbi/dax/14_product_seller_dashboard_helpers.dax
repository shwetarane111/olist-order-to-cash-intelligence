
-- =====================================================
-- PROJECT: Order-to-Cash Intelligence Platform
-- STEP: 7.4 Task 5
-- PAGE: 05 Product and Seller Performance
-- FILE: 14_product_seller_dashboard_helpers.dax
-- =====================================================

-- MEASURE: Create under _Measures > New measure.

Top 10 Seller Item Price (Dashboard) =
VAR SellerPriceTable =
    CALCULATETABLE(
        ADDCOLUMNS(
            VALUES('dim_seller'[seller_id]),
            "@ItemPrice",
                COALESCE(
                    CALCULATE([Recorded Item Price]),
                    0
                )
        ),
        REMOVEFILTERS('dim_seller')
    )

VAR TopTenSellers =
    TOPN(
        10,
        SellerPriceTable,
        [@ItemPrice], DESC,
        'dim_seller'[seller_id], ASC
    )

RETURN
    COALESCE(
        SUMX(TopTenSellers, [@ItemPrice]),
        0
    )


-- OPTIONAL CALCULATED COLUMN:
-- Create under dim_seller > New column.

Seller Display ID =
LEFT(
    'dim_seller'[seller_id],
    8
)
& "..."
& RIGHT(
    'dim_seller'[seller_id],
    4
)


